{
  "baseUrl": "/mb-test-deploy-2",
  "titlePrefix": "",
  "titleSuffix": "",
  "enableSearch": "false",
  "ignore": [
    "_markbind/layouts/*",
    "_markbind/logs/*",
    "_site/*",
    "site.json",
    "*.md",
    "*.njk",
    ".git/*",
    ".gitignore",
    "node_modules/*"
  ],
  "plugins": [
    "mermaid",
    "codeBlockWrapButtons",
    "codeBlockCopyButtons"
  ],
  "pluginsContext" : {
    "filterTags" : {
      "tags": ["environment--combined"]
    },
    "mathDelimiters": {
      "delimiters": ["beg_end"]
    },
    "web3Form": {
      "accessKey": [""]
    }
  },
  "pagesExclude": ["node_modules/*"],
  "pages": [
    {
      "src": "index.md"
    },
    {
      "glob": ["**/index.md", "**/*.md"]
    }
  ],
  "deploy": {
    "message": "Site Update."
  }
}
